# ---------------------------------------------------------------------------
# Client (Vite) environment — injected into the browser bundle.
# Only VITE_-prefixed variables are exposed to the frontend.
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Pages Function: /api/orders/validate (server-side order pricing)
# These are NOT exposed to the browser. The function fails closed with 503 if
# FIREBASE_PROJECT_ID or FIRESTORE_DATABASE_ID are missing.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Firebase Service Account used to authenticate the Firestore REST lookup so
# server-side price validation actually succeeds (instead of 401/502).
# Generate a key in Firebase Console > Project settings > Service accounts,
# then set FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY (the "private_key" field).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Cloudinary image uploads (src/utils/cloudinaryUpload.ts)
# The upload preset (currently "dalil_uploads") MUST be configured with:
#   - folder restrictions (upload only to a dedicated folder),
#   - max file size + allowed resource types (image/webp, jpg, png),
#   - SIGNED uploads (disable the unsigned preset) or a signed policy,
#   - and HTTP-referrer / domain restrictions.
# Keep all Cloudinary credentials in the deployment env, never in the repo.
# ---------------------------------------------------------------------------
